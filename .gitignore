# Build output
/game
/mapshot
*.exe
*.test
*.out
/bin/
/dist/

# Go tooling
coverage.*
*.prof

# Generated by the map preview tool (go run ./cmd/mapshot)
map.png

# Save files (the game saves to ~/.local/share/oldworld2, but -save can point anywhere)
*.db
*.db-wal
*.db-shm

# Claude Code: personal permission settings
.claude/settings.local.json

# Editors and OS
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Art generation: candidate images to pick from (only the chosen seed is kept)
assets/generated/*/candidates/
assets/generated/*/raw/*_s[0-9]*

# Made by tools/release/windows.sh
internal/assets/bundle.zip

# Art generation logs: they hold local paths and hardware details
*.log

# Screenshots from test runs
shots/

# Quaternius 3D packs (CC0, ~940 MB) for the 3D prototype; unpacked from the downloads
assets/quaternius/

# Python caches and Go debugger binaries
__pycache__/
__debug_bin*
